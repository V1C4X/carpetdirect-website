# Resend transactional email (https://resend.com)
RESEND_API_KEY=re_xxx

# Where leads are delivered
LEAD_TO_EMAIL=carpetdirectsale@gmail.com

# Resend verified sender — before DNS cutover use Resend default; after cutover use leads@carpetdirect.nz
LEAD_FROM_EMAIL=leads@carpetdirect.nz

# Set to 'development' or 'production' (Next.js sets this automatically; only override for testing)
# NODE_ENV=development
